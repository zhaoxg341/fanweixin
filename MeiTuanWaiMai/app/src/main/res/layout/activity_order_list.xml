<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:orientation="vertical">

    <include layout="@layout/title_bar" />

    <!-- 状态 Tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/white"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_all"
                android:textColor="@color/sort_text_color"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_all"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/orange" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_unpaid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_unpaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_unpaid"
                android:textColor="@color/sort_text_color"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_unpaid"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/orange"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_delivering"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_delivering"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_delivering"
                android:textColor="@color/sort_text_color"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_delivering"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/orange"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_done"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_done"
                android:textColor="@color/sort_text_color"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_done"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/orange"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_order"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_order"
                android:tint="@color/line_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="还没有相关订单"
                android:textColor="@color/text_light"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_go_home"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tag_orange"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="去点单"
                android:textColor="@color/orange"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
