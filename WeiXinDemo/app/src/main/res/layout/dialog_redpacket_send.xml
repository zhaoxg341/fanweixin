<?xml version="1.0" encoding="utf-8"?>
<!-- 发红包弹窗（微信样式：白底底部面板） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_top"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="16dp"
    android:paddingRight="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/rp_send_title"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rp_amount_label"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/et_rp_amount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/rp_amount_hint"
            android:inputType="numberDecimal"
            android:maxLength="8"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rp_amount_unit"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_rp_greeting"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="@string/rp_greeting_hint"
        android:inputType="text"
        android:maxLength="20"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btn_rp_send"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_redpacket"
        android:gravity="center"
        android:text="@string/rp_send_btn"
        android:textColor="@color/white"
        android:textSize="16sp" />
</LinearLayout>
