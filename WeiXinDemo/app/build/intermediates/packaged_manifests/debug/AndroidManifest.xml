<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.itcast.weixin"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!-- 联网权限：若启用服务器模式需要用到 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="cn.itcast.weixin.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="cn.itcast.weixin.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="cn.itcast.weixin.WeixinApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.WeiXin"
        android:usesCleartextTraffic="true" >

        <!-- 登录页：填昵称与服务器地址，用户已登录时会直接跳到主界面 -->
        <activity
            android:name="cn.itcast.weixin.activity.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主界面：底部四个 Tab（微信 / 通讯录 / 发现 / 我） -->
        <activity
            android:name="cn.itcast.weixin.activity.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 聊天界面 -->
        <activity
            android:name="cn.itcast.weixin.activity.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 朋友圈 -->
        <activity
            android:name="cn.itcast.weixin.activity.MomentsActivity"
            android:exported="false" />

        <!-- 发动态：文字 + 相册图片 -->
        <activity
            android:name="cn.itcast.weixin.activity.PublishMomentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 小游戏：从聊天页「+」或发现页游戏大厅进入 -->
        <activity
            android:name="cn.itcast.weixin.activity.GameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 游戏大厅：三个玩法 + 选择对手 -->
        <activity
            android:name="cn.itcast.weixin.activity.GameLobbyActivity"
            android:exported="false" />

        <!-- 全屏看大图：朋友圈九宫格、聊天气泡里的图片都跳这里 -->
        <activity
            android:name="cn.itcast.weixin.activity.PhotoViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.WeiXin" />

        <!-- 联系人资料页 -->
        <activity
            android:name="cn.itcast.weixin.activity.UserInfoActivity"
            android:exported="false" />

        <!-- 收藏页（我-收藏） -->
        <activity
            android:name="cn.itcast.weixin.activity.FavoriteActivity"
            android:exported="false" />

        <!-- 设置页（我-设置） -->
        <activity
            android:name="cn.itcast.weixin.activity.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="cn.itcast.weixin.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>