<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天界面：标题栏 + 消息列表 + 输入栏 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/title_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_msg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:listSelector="@android:color/transparent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:transcriptMode="alwaysScroll" />

        <!-- 按住说话时盖在列表上的提示 -->
        <TextView
            android:id="@+id/tv_talk_overlay"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_hold_talk"
            android:gravity="center"
            android:text="@string/voice_release_send"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/line_gray" />

    <LinearLayout
        android:id="@+id/ll_input_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/bg_page"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageView
            android:id="@+id/iv_voice"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_voice"
            android:contentDescription="@string/input_hint" />

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/input_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <!-- 语音模式下替换输入框的「按住 说话」按钮 -->
        <TextView
            android:id="@+id/tv_hold_talk"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="@string/voice_hold_talk"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_emoji"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_emoji_gray"
            android:contentDescription="@string/emoji" />

        <ImageView
            android:id="@+id/iv_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add_circle"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/tv_send"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_green_selector"
            android:gravity="center"
            android:minWidth="62dp"
            android:text="@string/send"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
