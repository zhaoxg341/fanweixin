<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：标题栏 + 分组设置项 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/title_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 个人资料组 -->
            <TextView
                style="@style/GroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/my_profile" />

            <include
                android:id="@+id/row_nick"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/row_wxid"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/row_gender"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/row_region"
                layout="@layout/item_setting" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- 聊天设置组 -->
            <include
                android:id="@+id/row_server"
                layout="@layout/item_setting" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <TextView
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:background="@drawable/bg_item_selector"
                android:gravity="center"
                android:text="@string/settings_logout"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
