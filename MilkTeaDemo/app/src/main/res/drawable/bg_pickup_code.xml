<?xml version="1.0" encoding="utf-8"?>
<!-- 取餐码卡片：白底 + 主色虚线边框 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/white" />
    <stroke
        android:width="1dp"
        android:color="@color/primary"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="10dp" />
</shape>
